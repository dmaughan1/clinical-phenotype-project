@dc:title "Patients, evaluations, evidence"
@dc:description "Synthetic patients evaluated against the criteria. Exclusion is derived, not asserted."
description <http://www.example.com/phenotype/description/cohort#> as cohort {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.w3.org/2000/01/rdf-schema#> as rdfs
    uses <http://www.example.com/phenotype/vocabulary#> as phenotype
    extends <http://www.example.com/phenotype/description/definition#> as definition

    // --- patients (synthetic) ---

    @rdfs:label "Patient 0001"
    @dc:description "HbA1c 7.8%, T2DM dx, no T1."
    instance PatientAnon001 : phenotype:Patient [
        phenotype:id "PT-0001"
    ]

    @rdfs:label "Patient 0002"
    @dc:description "T1DM dx; excluded from the T2DM cohort."
    instance PatientAnon002 : phenotype:Patient [
        phenotype:id "PT-0002"
    ]

    @rdfs:label "Patient 0003"
    @dc:description "HbA1c 8.1%, no coded diagnosis. Found only through the lab criterion."
    instance PatientAnon003 : phenotype:Patient [
        phenotype:id "PT-0003"
    ]

    @rdfs:label "Patient 0004"
    @dc:description "Coded T2DM diagnosis, no lab on file."
    instance PatientAnon004 : phenotype:Patient [
        phenotype:id "PT-0004"
    ]

    // --- evaluations (patient x criterion) ---

    @rdfs:label "P0001 meets HbA1c criterion"
    relation instance Eval001HbA1c : phenotype:Evaluation [
        from PatientAnon001
        to definition:HbA1cGE65
        phenotype:id "EVAL-0001-HBA1C"
        phenotype:membershipStatus "Included"
    ]

    @rdfs:label "P0001 meets diagnosis criterion"
    relation instance Eval001Dx : phenotype:Evaluation [
        from PatientAnon001
        to definition:T2dmDx
        phenotype:id "EVAL-0001-DX"
        phenotype:membershipStatus "Included"
    ]

    @rdfs:label "P0002 meets type 1 exclusion"
    relation instance Eval002ExcludeT1 : phenotype:Evaluation [
        from PatientAnon002
        to definition:ExcludeT1
        phenotype:id "EVAL-0002-EXT1"
        phenotype:membershipStatus "Excluded"
    ]

    @rdfs:label "P0003 meets HbA1c criterion"
    relation instance Eval003HbA1c : phenotype:Evaluation [
        from PatientAnon003
        to definition:HbA1cGE65
        phenotype:id "EVAL-0003-HBA1C"
        phenotype:membershipStatus "Included"
    ]

    @rdfs:label "P0004 meets diagnosis criterion"
    relation instance Eval004Dx : phenotype:Evaluation [
        from PatientAnon004
        to definition:T2dmDx
        phenotype:id "EVAL-0004-DX"
        phenotype:membershipStatus "Included"
    ]

    // --- evidence ---

    @rdfs:label "Lab result: HbA1c 7.8%"
    @dc:description "Observation HbA1c = 7.8% on 2024-05-12."
    instance EvidenceHbA1c001 : phenotype:Evidence [
        phenotype:id "EV-HBA1C-001"
        phenotype:supports Eval001HbA1c
    ]

    @rdfs:label "Coded diagnosis: T2DM"
    @dc:description "Condition 44054006 recorded 2023-11-02."
    instance EvidenceDx001 : phenotype:Evidence [
        phenotype:id "EV-DX-001"
        phenotype:supports Eval001Dx
    ]

    @rdfs:label "Coded diagnosis: T1DM"
    @dc:description "Condition 46635009 recorded 2022-03-18."
    instance EvidenceT1002 : phenotype:Evidence [
        phenotype:id "EV-T1-002"
        phenotype:supports Eval002ExcludeT1
    ]

    @rdfs:label "Lab result: HbA1c 8.1%"
    @dc:description "Observation HbA1c = 8.1% on 2024-07-30."
    instance EvidenceHbA1c003 : phenotype:Evidence [
        phenotype:id "EV-HBA1C-003"
        phenotype:supports Eval003HbA1c
    ]

    @rdfs:label "Coded diagnosis: T2DM (P0004)"
    @dc:description "Condition 44054006 recorded 2024-01-15."
    instance EvidenceDx004 : phenotype:Evidence [
        phenotype:id "EV-DX-004"
        phenotype:supports Eval004Dx
    ]
}
